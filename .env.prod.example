# Vorlage für .env.prod – Datei kopieren und Werte ersetzen, niemals einchecken.
DJANGO_SECRET_KEY=bitte-64-zufallszeichen-eintragen
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=portal.schachverein.de
POSTGRES_DB=schachverein
POSTGRES_USER=schachverein
POSTGRES_PASSWORD=bitte-starkes-passwort-setzen
# E-Mail-Versand (Rundbriefe, Fehlerbenachrichtigung)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.vereinsprovider.de
EMAIL_PORT=587
EMAIL_HOST_USER=portal@schachverein.de
EMAIL_HOST_PASSWORD=bitte-smtp-passwort-setzen
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=portal@schachverein.de
DJANGO_ADMINS=Vorstand:vorstand@schachverein.de
# Vereinsprofil (ADR-012). Die Werte der oeffentlichen Vereinsseite sind
# optional: bleibt ein Wert leer, blendet die Seite die betroffene Zeile aus,
# statt einen Platzhalter zu erfinden.
CLUB_NAME=Schachclub Königsspringer Musterstadt e.V.
CLUB_SHORT=SC Königsspringer
CLUB_CONTACT=vorstand@koenigsspringer-musterstadt.de
CLUB_FOUNDED=1978
CLUB_LOCATION=Musterstadt
CLUB_ROOM=Vereinsheim Musterstadt, Musterstraße 1
CLUB_NIGHT_HOURS=Donnerstags ab 19:00 Uhr
CLUB_YOUTH_HOURS=Donnerstags 17:30 – 19:00 Uhr
CLUB_DESCRIPTION=Schach für alle – vom ersten Bauernzug bis zur Ligapartie.
# Produkt-Landingpage (/produkt/) & Marketing-Routing (ADR-024)
PRODUCT_NAME=Schachverwaltung.de
PRODUCT_CONTACT=kontakt@schachverwaltung.de
# Wenn IS_MARKETING_SITE=1 oder Hostname in PRODUCT_HOSTS, liegt die Produktseite auf "/"
IS_MARKETING_SITE=0
PRODUCT_HOSTS=schachverwaltung.de,www.schachverwaltung.de
# SEPA-Lastschriften (pain.008 / ADR-017 / PRD S2.7)
# Gläubiger-Identifikationsnummer (von der Bundesbank vergeben, z. B. DE98ZZZ09999999999)
SEPA_CREDITOR_ID=DE98ZZZ09999999999
SEPA_CREDITOR_IBAN=DE89370400440532013000
# SEPA_CREDITOR_BIC=
# SEPA_CREDITOR_NAME=
# Sicherheit & Datenschutz
TWOFA_PFLICHT=1
# Progressive Web App (PWA, PRD N2.7) - temporär deaktiviert (0 = aus, 1 = an)
PWA_AKTIV=0
DSGVO_FRIST_TAGE=730
# Verschluesselung der IBAN (ADR-010). Eigenen Schluessel erzeugen:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Getrennt vom DB-Host ablegen und nie ins Repository einchecken. Ohne diesen
# Wert startet der Produktivbetrieb nicht.
IBAN_FERNET_KEY=bitte-eigenen-schluessel-eintragen
# Verschluesselung der Backups (PRD N2.1 / ADR-009). Eigenen Schluessel erzeugen:
#   openssl rand -base64 32
# Getrennt vom DB-Host im Passwortmanager sichern und nie ins Repo einchecken.
BACKUP_ENCRYPTION_KEY=bitte-backup-schluessel-eintragen
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
CSRF_TRUSTED_ORIGINS=https://portal.schachverein.de
# Ratenbegrenzungs-IP-Extraktion hinter Reverse Proxy (Standard: core.middleware.get_ratelimit_ip)
RATELIMIT_IP_META_KEY=core.middleware.get_ratelimit_ip

# DSB-Wertungsportal-Schnittstelle (ADR-016 / K3.6)
# Zugangsschlüssel und VKZ vom Deutschen Schachbund für den Verein:
DSB_VKZ=61313
DSB_API_TOKEN=adae738aedc07673efababb154b4e36595a2198c

# Monitoring & Backup-Überwachung mit Uptime Kuma (PRD N2.8 / ADR-009 / T24b)
# Push-Monitor-URL für das nächtliche Backup (z. B. http://uptime-kuma:3001/api/push/<token>?status=up&msg=OK)
KUMA_PUSH_URL=
