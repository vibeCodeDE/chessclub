# Vorlage für .env.prod – Datei kopieren und Werte ersetzen, niemals einchecken.
DJANGO_SECRET_KEY=bitte-64-zufallszeichen-eintragen
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=portal.schachverein.de
POSTGRES_DB=schachverein
POSTGRES_USER=schachverein
POSTGRES_PASSWORD=bitte-starkes-passwort-setzen
# E-Mail-Versand (Rundbriefe, Fehlerbenachrichtigung)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.vereinsprovider.de
EMAIL_PORT=587
EMAIL_HOST_USER=portal@schachverein.de
EMAIL_HOST_PASSWORD=bitte-smtp-passwort-setzen
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=portal@schachverein.de
DJANGO_ADMINS=Vorstand:vorstand@schachverein.de
# Vereinsprofil
CLUB_NAME=Schachclub Königsspringer Musterstadt e.V.
CLUB_SHORT=SC Königsspringer
CLUB_CONTACT=vorstand@koenigsspringer-musterstadt.de
# Produkt-Landingpage (/produkt/)
PRODUCT_NAME=Schachclub-Manager
PRODUCT_CONTACT=hallo@schachclub-manager.example
# Sicherheit & Datenschutz
TWOFA_PFLICHT=1
DSGVO_FRIST_TAGE=730
# Verschluesselung der IBAN (ADR-010). Eigenen Schluessel erzeugen:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Getrennt vom DB-Host ablegen und nie ins Repository einchecken. Ohne diesen
# Wert startet der Produktivbetrieb nicht.
IBAN_FERNET_KEY=bitte-eigenen-schluessel-eintragen
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
CSRF_TRUSTED_ORIGINS=https://portal.schachverein.de
